#!/usr/bin/env bash
# Hermes backend tunnel.
#
# Forwards the Hermes gateway API and dashboard to localhost, so
# hermes-workspace's default URLs work with no config changes:
#
#   HERMES_API_URL        -> http://127.0.0.1:8642   (chat completions, models)
#   HERMES_DASHBOARD_URL  -> http://127.0.0.1:9119   (sessions, skills, config, cron)
#
# Both services are bound to loopback on the remote host on purpose: a
# non-loopback bind makes the dashboard demand OAuth, and it puts a
# shell-capable API on the LAN in cleartext. SSH gives us encryption and
# auth for free.
#
# The host is not stored in this repo. Set HERMES_HOST in the environment, or
# keep it in an untracked ~/.config/hermes/env:
#
#   # ~/.config/hermes/env
#   HERMES_HOST=hermes@your-host
#
# Usage:  hermes-tunnel            (Ctrl-C to stop)
#         HERMES_HOST=hermes@host hermes-tunnel

set -euo pipefail

HERMES_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/hermes/env"
# shellcheck source=/dev/null
[[ -z ${HERMES_HOST:-} && -r $HERMES_ENV ]] && . "$HERMES_ENV"

if [[ -z ${HERMES_HOST:-} ]]; then
  echo "error: HERMES_HOST is not set" >&2
  echo "       export HERMES_HOST=hermes@your-host, or put it in $HERMES_ENV" >&2
  exit 1
fi

REMOTE="$HERMES_HOST"

trap 'printf "\ntunnel closed.\n"; exit 0' INT TERM

# Refuse to start a second copy — ssh would fail on the bind and the retry
# loop below would spin forever.
for port in 8642 9119; do
  if ss -tln 2>/dev/null | grep -q "127\.0\.0\.1:${port} "; then
    echo "error: 127.0.0.1:${port} is already bound — tunnel already running?" >&2
    echo "       check with: ss -tlnp | grep -E '8642|9119'" >&2
    exit 1
  fi
done

echo "hermes tunnel -> ${REMOTE}"
echo "  127.0.0.1:8642  gateway API"
echo "  127.0.0.1:9119  dashboard"
echo "Ctrl-C to stop."

while :; do
  ssh -N \
    -L 8642:127.0.0.1:8642 \
    -L 9119:127.0.0.1:9119 \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    "${REMOTE}" || true

  echo "tunnel dropped — reconnecting in 5s" >&2
  sleep 5
done
